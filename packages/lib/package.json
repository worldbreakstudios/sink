{
  "name": "@worldbreakstudios/sink-lib",
  "version": "0.2.3",
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/copy-sqlite-assets.mjs",
    "lint": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@tanstack/db": "^0.5.30",
    "vite": "^7.3.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/db": "^0.5.30",
    "@types/node": "^24.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.51.2-build6",
    "ws": "^8.18.3"
  }
}
