    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@worldbreakstudios/sink-lib": "workspace:*",
    "glob": "^11.0.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
