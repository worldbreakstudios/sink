{
  "name": "@worldbreakstudios/sink-cli",
  "version": "0.1.1",
  "type": "module",
  "publishConfig": {
    "access": "private"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sink": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "cli": "tsx src/cli.ts",
    "lint": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@worldbreakstudios/sink-lib": "0.1.1",
    "glob": "^11.0.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
